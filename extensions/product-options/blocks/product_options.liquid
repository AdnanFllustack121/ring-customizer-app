{%- comment -%}
{% assign avg_rating = block.settings.product.metafields.demo.avg_rating.value | round %}
<span style="color:{{ block.settings.colour }}">
  {% render 'stars', rating: avg_rating %}
</span>
{% if avg_rating >= 4 %}
  <br>
  <img src="{{ "thumbs-up.png" | asset_img_url: '15x' }}" height="15" width="15" loading="lazy">
  {{ 'ratings.home.recommendationText' | t }}
{% endif %}
{%- endcomment -%}

<div id="jewelry-builder-app-root"></div>
<script id="jewelrybuilderapp" type="application/ld+json">
{
  "title": {{ product.title | json }},
  "description": {{ product.description | json }},
  "vendor": {{ product.vendor | json }},
  "featured_image": "{{ product.featured_image }}",
  "featured_media": "{{ product.featured_media }}",
  "vendor": "{{ product.vendor }}",
  "sku": "{{ product.selected_or_first_available_variant.sku }}",
  "metafields": {{ product.metafields.jewelrybuilderapp | json }},
  "file_url": "{{ '' | file_url }}"
}
</script>

{% schema %}
{
  "name": "Product Options",
  "target": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "stylesheet": "main.css",
  "javascript": "main.js",
  "settings": [
    { "type": "product", "id": "product", "label": "product", "autofill": true }
  ]
}
{% endschema %}